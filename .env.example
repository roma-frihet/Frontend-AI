# 이 파일을 복사해 .env.local 로 만들고 값을 채운다. (.env.local 은 git에 올리지 않는다)

# --- 백엔드 API ---
# next.config.ts의 rewrites가 /api/v1/* 을 이 주소로 넘긴다. 서버에서만 쓰이고 브라우저에 노출되지 않는다.
# 로컬: http://localhost:8080 / 배포본: https://server-prod-cphdbynbja-du.a.run.app
API_ORIGIN=http://localhost:8080

# 프록시를 쓸 수 없는 환경(정적 호스팅 등)에서만 설정한다.
# 비워 두면 같은 출처(/api/v1/...)로 호출하므로 CORS가 필요 없다.
# 값을 넣으면 브라우저가 백엔드를 직접 부르므로 백엔드에 CORS 설정이 있어야 한다.
NEXT_PUBLIC_API_BASE_URL=

# --- Supabase Auth ---
# 로그인·회원가입·토큰 발급은 서버가 아니라 Supabase가 한다.
# 로컬: http://127.0.0.1:54321 / 원격: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# 공개용 키다. 브라우저에 노출되어도 되는 값이다.
# (service_role 키는 서버 전용이므로 프론트에 절대 넣지 않는다)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 학생 로그인 ---
# 학번을 이메일 모양으로 바꿀 때 붙이는 도메인. 서버의 STUDENT_LOGIN_EMAIL_DOMAIN과 반드시 같아야 한다.
# 비워 두면 students.roma-frihet.app 을 쓴다.
NEXT_PUBLIC_STUDENT_LOGIN_EMAIL_DOMAIN=

# --- API 스펙 ---
# npm run api:sync가 스펙을 받아올 주소. 로컬 백엔드를 띄웠다면 localhost:8080을 쓴다.
API_SPEC_URL=http://localhost:8080/v3/api-docs
