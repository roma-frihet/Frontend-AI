# 스펙 저장소 기본 URL. api:pull이 ${API_SPEC_BASE_URL}/${API_SPEC_SERVICE}/${version}/openapi.json 을 받는다.
API_SPEC_BASE_URL=

# 스펙 저장소의 백엔드 서비스 이름 (생략하면 backend)
API_SPEC_SERVICE=backend

# 스펙 저장소에 인증이 필요할 때만 설정. Authorization: Bearer <토큰> 으로 전송된다.
API_SPEC_TOKEN=

# 브라우저에서 호출할 백엔드 API의 기본 URL (클라이언트에 노출됨)
NEXT_PUBLIC_API_BASE_URL=
